{
    "name": "mados",
    "version": "1.0.0",
    "author": "Karol Modzelewski",
    "scripts": {
        "ng": "ng",
        "start:dev": "ng serve --configuration development",
        "start:prod": "ng serve --configuration production",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "format": "prettier --write .",
        "lint": "ng lint",
        "lint:fix": "ng lint --fix",
        "prepare": "cd .. && husky"
    },
    "lint-staged": {
        "**/*.ts": [
            "eslint --fix",
            "prettier --write . --ignore-unknown"
        ]
    },
    "private": true,
    "dependencies": {
        "@angular/cdk": "^22.2.5",
        "@angular/common": "^22.2.4",
        "@angular/compiler": "^22.2.4",
        "@angular/core": "^22.2.4",
        "@angular/forms": "^22.2.4",
        "@angular/material": "^22.2.5",
        "@angular/platform-browser": "^22.2.4",
        "@angular/router": "^22.2.4",
        "rxjs": "~7.8.2",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@angular-eslint/builder": "^22.6.0",
        "@angular-eslint/eslint-plugin": "^22.6.0",
        "@angular-eslint/schematics": "^22.6.0",
        "@angular-eslint/template-parser": "^22.6.0",
        "@angular/build": "^22.2.5",
        "@angular/cli": "^22.2.5",
        "@angular/compiler-cli": "^22.2.4",
        "@eslint/compat": "^2.1.1",
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^9.39.5",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "angular-eslint": "^22.6.0",
        "eslint": "^9.39.5",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "husky": "^9.1.7",
        "jsdom": "^30.1.3",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "vitest": "^5.0.5"
    }
}
