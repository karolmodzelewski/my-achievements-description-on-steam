{
    "name": "mados",
    "version": "1.0.0",
    "author": "Karol Modzelewski",
    "private": true,
    "scripts": {
        "build": "nest build",
        "format": "prettier --write .",
        "start:dev": "cross-env STAGE=dev nest start --watch",
        "start:prod": "cross-env STAGE=prod node dist/main",
        "start:e2e": "cross-env STAGE=e2e nest start --path tsconfig.e2e.json",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
        "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "prepare": "cd .. && husky"
    },
    "lint-staged": {
        "**/*.ts": [
            "eslint --fix",
            "prettier --write --ignore-unknown"
        ]
    },
    "dependencies": {
        "@nestjs/common": "^12.5.0",
        "@nestjs/config": "^12.1.1",
        "@nestjs/core": "^12.5.0",
        "@nestjs/platform-express": "^12.5.0",
        "@nestjs/typeorm": "^12.0.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "joi": "^18.3.2",
        "pg": "^8.23.1",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^1.1.3"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^9.39.5",
        "@nestjs/cli": "^12.0.13",
        "@nestjs/schematics": "^12.0.13",
        "@nestjs/testing": "^12.5.0",
        "@stylistic/eslint-plugin": "^6.0.0",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "@typescript-eslint/eslint-plugin": "^8.72.2",
        "@typescript-eslint/parser": "^8.72.2",
        "@vitest/coverage-v8": "^5.1.0",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.5",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.10.1",
        "typescript": "~6.0.3",
        "vitest": "^5.1.0"
    }
}
