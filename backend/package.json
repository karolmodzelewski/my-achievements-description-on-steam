{
    "name": "mados",
    "version": "1.0.0",
    "author": "Karol Modzelewski",
    "private": true,
    "scripts": {
        "build": "nest build",
        "format": "prettier --write .",
        "start:dev": "cross-env STAGE=dev nest start --watch",
        "start:prod": "cross-env STAGE=prod node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
        "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
        "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
        "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
        "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register ./node_modules/jest/bin/jest.js --runInBand",
        "prepare": "cd .. && husky"
    },
    "lint-staged": {
        "**/*.ts": [
            "eslint --fix",
            "prettier --write --ignore-unknown"
        ]
    },
    "dependencies": {
        "@nestjs/common": "^12.4.2",
        "@nestjs/config": "^12.1.1",
        "@nestjs/core": "^12.4.2",
        "@nestjs/platform-express": "^12.4.2",
        "@nestjs/typeorm": "^12.0.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "joi": "^18.3.2",
        "pg": "^8.23.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "typeorm": "^1.1.2"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^9.39.5",
        "@nestjs/cli": "^12.0.12",
        "@nestjs/schematics": "^12.0.13",
        "@nestjs/testing": "^12.4.2",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.19.2",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.5",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "source-map-support": "^0.5.21",
        "ts-jest": "^29.4.15",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "~6.0.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
